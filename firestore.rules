rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin' && me().status == 'approved'; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // The very first account becomes admin. Everyone after that starts as a pending member.
    match /meta/{d} {
      allow read: if signedIn();
      allow create: if signedIn() && !setupDone();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth.uid == uid && (
        (!setupDone() && request.resource.data.role == 'admin') ||
        (request.resource.data.role == 'member' && request.resource.data.status == 'pending'
          && request.resource.data.perms.size() == 0));
      allow update, delete: if isAdmin();
    }

    // VAT %, GPS limit, etc. Everyone reads, only admin writes.
    match /settings/{d} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Cost prices (Phase 2): admin only, never readable by members.
    match /productCosts/{d} {
      allow read, write: if isAdmin();
    }
  }
}
